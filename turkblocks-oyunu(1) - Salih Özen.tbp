<!DOCTYPE html>
<html lang="tr">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>TürkBlocks Oyunu</title>

<style>

html,
body {

    margin:0;

    width:100%;

    height:100%;

    overflow:hidden;

    background:#000;

}

#game {

    position:relative;

    width:960px;

    height:540px;

    margin:0 auto;

    background:#eee;

    overflow:hidden;

}

#turkblocks-exit {

    position:absolute;

    top:10px;

    left:10px;

    z-index:999999;

    padding:8px 12px;

    border:0;

    border-radius:5px;

    background:#500000;

    color:white;

    cursor:pointer;

}

</style>

</head>

<body>

<div id="game">

<button
    id="turkblocks-exit"
    onclick="exitTurkBlocks()"
>
    Oyundan Çık
</button>


<div
    style="
        position:absolute;
        left:302px;
        top:425px;
        width:150px;
        height:50px;
        color:#500000;
        background:#dddddd;
        font-size:0px;
        display:flex;
        align-items:center;
        justify-content:center;
        padding:5px;
        cursor:default;
        border-radius:0;
        border:none;
    "
>
    
</div>

<div
    style="
        position:absolute;
        left:100px;
        top:100px;
        width:150px;
        height:50px;
        color:#500000;
        background:transparent;
        font-size:24px;
        display:flex;
        align-items:center;
        justify-content:center;
        padding:5px;
        cursor:default;
        border-radius:0;
        border:none;
    "
>
    test
</div>


</div>

<script>

function exitTurkBlocks() {

    /*
     * TürkBlocks WebView tarafından yakalanacak.
     * Gerçek WebView entegrasyonunda buraya
     * TürkBlocks'a dönüş çağrısı bağlanacak.
     */

    if (
        window.TurkBlocks &&
        typeof window.TurkBlocks.exitGame === "function"
    ) {

        window.TurkBlocks.exitGame();

    }

}

</script>

</body>

</html>